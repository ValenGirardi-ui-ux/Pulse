# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. The public address of the app, used in email and Google sign-in links.
# Leave it empty locally; on Vercel set it to your domain, e.g. https://pulse.app
NEXT_PUBLIC_SITE_URL=
