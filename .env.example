# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional. The public address of the app, used in email and Google sign-in links.
# Leave it empty locally; on Vercel set it to your domain, e.g. https://pulse.app
NEXT_PUBLIC_SITE_URL=

# Optional. Get an email each time someone writes through the contact form (https://resend.com).
# Without a verified domain, Resend only delivers to the email you signed up with.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# Optional. Sender once you verify your domain in Resend, e.g. Pulse <hola@pulse.app>
CONTACT_FROM_EMAIL=

# Daily automatic scan (Vercel Cron, see vercel.json). Needed in Vercel, not locally.
# SUPABASE_SECRET_KEY: Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Never expose it.
SUPABASE_SECRET_KEY=
# Any long random text. Vercel sends it to /api/cron/scan so nobody else can trigger the scan.
CRON_SECRET=
# Optional. Sender for alert emails once you verify a domain in Resend, e.g. Pulse <alertas@tudominio.com>
EMAIL_FROM=
